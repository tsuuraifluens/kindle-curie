<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title & Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Root 与系统文件安全管理"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="受控文件事务、修改前强制备份、SHA-256 校验与崩溃恢复中心"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <!-- Pending Recovery Alert Card (Visible when unfinished transactions exist) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPendingRecovery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardCornerRadius="10dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/status_red"
            app:strokeWidth="2dp"
            app:cardBackgroundColor="#FFEBEE">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[状态: 待恢复处理] 检测到未完成或中断的 Root 事务"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/status_red" />

                <TextView
                    android:id="@+id/tvPendingRecoveryDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:text="正在加载待恢复事务详情..." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnRecoveryRestoreNow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="恢复原始状态"
                        android:textSize="12sp"
                        android:backgroundTint="@color/status_red" />

                    <Button
                        android:id="@+id/btnAcknowledgeRecovery"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="确认状态并解除锁定"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 1: Root Environment Status -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="一、Root 权限与系统环境状态"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/primary_dark" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/divider" />

                <TextView
                    android:id="@+id/tvRootEnvSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_primary"
                    android:text="正在等待检测... 请点击下方「检查 Root 环境」按钮。" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2: Managed Target File & Backup Status -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="二、受管理系统文件与备份校验状态"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/primary_dark" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/divider" />

                <TextView
                    android:id="@+id/tvTargetFileStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:text="目标路径: /data/misc/bluetooth/bt_did.conf\n状态: 尚未读取" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/divider" />

                <TextView
                    android:id="@+id/tvBackupAndTxStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_primary"
                    android:text="备份与事务状态: 正在读取本地持久化记录..." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 3: Live Execution Stage & Result -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="三、当前事务执行阶段与验证结果"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/primary_dark" />

                <TextView
                    android:id="@+id/tvLiveTransactionStage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:text="[状态: 空闲就绪] 等待用户指令" />

                <TextView
                    android:id="@+id/tvOperationResultDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#EEEEEE"
                    android:padding="8dp"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:text="提示：所有系统文件修改均会先创建并校验 SHA-256 备份，再通过原子替换执行。" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 4: Action Buttons -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="四、受控安全操作面板"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/primary_dark" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/divider" />

                <!-- Row 1: Check Root & Inspect File -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCheckRootEnv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="检查 Root 环境"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                    <Button
                        android:id="@+id/btnInspectTargetFile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="检查目标文件"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />
                </LinearLayout>

                <!-- Row 2: Create Standalone Backup & View Diff -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCreateBackup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="创建独立备份"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.TonalButton" />

                    <Button
                        android:id="@+id/btnViewDiff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="查看修改差异"
                        android:textSize="12sp"
                        style="@style/Widget.Material3.Button.TonalButton" />
                </LinearLayout>

                <!-- Row 3: Execute Modification & Restore Original -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnExecuteModify"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="执行受管理的文件修改"
                        android:textSize="12sp"
                        android:backgroundTint="@color/primary" />

                    <Button
                        android:id="@+id/btnRestoreOriginal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="恢复原始文件"
                        android:textSize="12sp"
                        android:backgroundTint="@color/status_orange" />
                </LinearLayout>

                <!-- Row 4: Export Backup, Backup List, Audit Logs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnExportBackup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="导出备份"
                        android:textSize="11sp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                    <Button
                        android:id="@+id/btnBackupList"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="备份列表详情"
                        android:textSize="11sp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                    <Button
                        android:id="@+id/btnViewAuditLog"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="查看审计日志"
                        android:textSize="11sp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 5: Backup Storage & Risk Notice -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFF8E1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="重要安全提示与备份存储说明"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@color/status_orange" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_primary"
                    android:text="1. 备份默认加密/校验保存在本应用私有持久化内部存储 (files/root_backups) 中，普通第三方应用无法访问，且在应用崩溃、强行停止或手机重启后完整保留。\n2. 【风险告知】卸载本应用、在系统设置中「清除应用数据」或恢复出厂设置会导致应用内备份丢失！建议在修改系统文件后点击「导出备份」将备份副本保存到安全外部位置，并在卸载应用前先点击「恢复原始文件」。\n3. 导出备份文件包含系统蓝牙配置及元数据，请妥善保管导出文件，勿在公开渠道分享。\n4. 本模块绝不会自动杀死或重启系统蓝牙守护进程。修改或恢复完成后，请手动在系统设置中重开蓝牙。" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
