<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_main"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="基于 REA 固件逆向成果 (FW 5.20.1) 的 BLE HOGP 模拟器"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <!-- Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="系统与外设状态"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/primary_dark" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/divider" />

                <!-- Bluetooth Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_bluetooth"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvBluetoothStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检查中..."
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <!-- BLE Peripheral Capability -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_ble_peripheral"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvPeripheralCap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检查中..."
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <!-- Permission Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_permissions"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvPermissions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检查中..."
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <!-- Advertising State -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_adv_state"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvAdvertisingState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="已停止"
                        android:textStyle="bold"
                        android:textColor="@color/status_red" />
                </LinearLayout>

                <!-- Connection State -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_conn_state"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvConnectionState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未连接"
                        android:textStyle="bold"
                        android:textColor="@color/status_red" />
                </LinearLayout>

                <!-- Device Identity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_identity_sim"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvIdentityStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VID:0x0171 PID:0x0443 (Amazon Lab126)"
                        android:textSize="12sp"
                        android:textColor="@color/status_green" />
                </LinearLayout>

                <!-- Implementation Mode -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="@string/label_mode"
                            android:textColor="@color/text_secondary" />
                        <TextView
                            android:id="@+id/tvMode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="普通模式 (BLE HOGP)"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary" />
                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/rgEmulationMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">
                        <RadioButton
                            android:id="@+id/rbModeBle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:textSize="11sp"
                            android:text="普通模式 (BLE)" />
                        <RadioButton
                            android:id="@+id/rbModeClassic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textSize="11sp"
                            android:text="高级模式 (Classic HID)" />
                    </RadioGroup>
                </LinearLayout>

                <!-- Last Action Result -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="#EEEEEE"
                    android:padding="6dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_last_result"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/tvLastResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="就绪"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Emulation Control Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartEmulation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_start_emulation"
                android:backgroundTint="@color/primary" />

            <Button
                android:id="@+id/btnStopEmulation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/btn_stop_emulation"
                android:backgroundTint="@color/status_red" />

            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/btn_disconnect"
                style="@style/Widget.Material3.Button.OutlinedButton" />
        </LinearLayout>

        <!-- Core Page Turner Control Panel -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="翻页控制台 (按键状态机)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <!-- Big Page Down Button (Next Page) -->
            <Button
                android:id="@+id/btnPageForward"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="下一页 (Page Down: 0x4E)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary" />

            <!-- Big Page Up Button (Previous Page) -->
            <Button
                android:id="@+id/btnPageBackward"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="10dp"
                android:text="上一页 (Page Up: 0x4B)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary_dark" />

            <!-- Additional Keys: Brightness Up / Down -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBrightUp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="背光增 (F14: 0x6F)"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnBrightDown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="背光减 (F15: 0x6E)"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Navigation & Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnResumeAdv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_resume_adv"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/btn_settings"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <Button
                android:id="@+id/btnDiagnostics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/btn_diagnostics"
                style="@style/Widget.Material3.Button.TonalButton" />
        </LinearLayout>

        <!-- Root & System File Safety Management Entry -->
        <Button
            android:id="@+id/btnRootManager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Root 与系统文件安全管理 (备份 / 校验 / 恢复)"
            style="@style/Widget.Material3.Button.OutlinedButton" />

    </LinearLayout>
</ScrollView>
